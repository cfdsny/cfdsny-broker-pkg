[Unit]
Description=CFDSNY Broker Operator GUI
After=multi-user.target

[Service]
Type=simple
User=pi
Environment=HOME=/home/pi
WorkingDirectory=/opt/cfdsny-broker
ExecStart=/usr/bin/startx /opt/cfdsny-broker/venv/bin/python3 /opt/cfdsny-broker/Desktop/run_operator.py -- :0 vt1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
